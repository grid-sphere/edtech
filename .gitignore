# Secrets. .env.example is committed; .env never is.
.env
.env.*
!.env.example

node_modules/
temp_videos/
dist/
.DS_Store
*.log

# Database backups.
#
# scripts/backup-database.js defaults to writing into the working directory,
# which is inside this repository. Those files hold every user row — names,
# email addresses, phone numbers, schools, and bcrypt password hashes — for an
# audience that is mostly school students. This repository is public. A single
# `git add .` after a backup would publish all of it, and the history would keep
# it there after the file was deleted.
*.sql
*.dump
db-backup*

# Whole-repository code dumps.
#
# combined_project_code.txt was a concatenation of every source file, which
# meant it also contained every credential that was hardcoded at the time —
# and it was committed, so those values are in the git history. Regenerating it
# would re-commit whatever secrets exist on the day it is made.
combined_project_code.txt
*_project_code.txt
